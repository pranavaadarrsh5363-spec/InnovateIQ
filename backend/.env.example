# ====================================================================
# InnovateIQ Backend Environment Configuration Template
# Copy to .env and set secure values for your target deployment
# ====================================================================

# Application Port
PORT=5000

# Environment Mode: development | test | staging | production
NODE_ENV=development

# JWT Secret Key (Generate a high-entropy string in production: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here

# PostgreSQL Database Connection String (Optional: persistent local fallback used if omitted)
# Example: postgresql://username:password@localhost:5432/innovateiq_db
DATABASE_URL=postgresql://user:password@localhost:5432/innovateiq

# Allowed Frontend Origins (Comma-separated for multi-origin CORS support)
FRONTEND_URL=http://localhost:5173,https://innovate-iq-liard.vercel.app

# Rate Limiting Configuration (Requests per 15-minute window)
RATE_LIMIT_MAX=600
